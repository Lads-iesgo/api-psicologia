# Configurações do Banco de Dados
DB_HOST=host_do_banco
DB_PORT=porta_do_banco
DB_USER=usuario_do_banco
DB_PASSWORD=senha_do_banco
DB_DATABASE=nome_do_banco
DATABASE_URL="mysql://username:password@localhost:3306/mydb"

# Porta da aplicação
PORT=3333

# Chave secreta para tokens JWT (deve ser uma string longa e aleatória em produção)
# Exemplo: execute em um terminal: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=chave_secreta_jwt_substituir_por_uma_chave_segura_em_producao

# Origens permitidas para CORS (opcional, separe múltiplas origens com vírgulas)
ALLOWED_ORIGINS=http://localhost:3000,http://example.com